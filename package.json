{
  "name": "choice-eq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate-colors && next build",
    "dev": "npm run generate-colors && concurrently \"next dev\" \"payload generate:types --watch\" \"payload generate:importmap --watch\"",
    "generate-colors": "node scripts/generate-colors.mjs",
    "lint": "eslint",
    "payload:generate": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:home": "tsx --env-file=.env.local scripts/seed-home.ts",
    "start": "next start",
    "vercel-build": "npm run generate-colors && payload migrate && NODE_ENV=production tsx scripts/seed-home.ts --if-empty && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/lib-storage": "^3.1000.0",
    "@hookform/resolvers": "^5.2.2",
    "@payloadcms/db-postgres": "^3.78.0",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "^3.78.0",
    "@payloadcms/richtext-lexical": "^3.78.0",
    "@payloadcms/storage-s3": "^3.78.0",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "^3.78.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "next": "^15.5.7",
    "payload": "^3.78.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "culori": "^4.0.2",
    "daisyui": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "graphql": "^16.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.16.0+sha512.8066e7b034217b700a9a4dbb3a005061d641ba130a89915213a10b3ca4919c19c037bec8066afdc559b89635fdb806b16ea673f2468fbb28aabfa13c53e3f769"
}
